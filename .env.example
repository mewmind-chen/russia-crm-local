PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CRM_PRODUCTION_ROOT=
CRM_RUNTIME_ROOT=
CRM_DB_PATH=
CRM_REPORTS_DIR=
CRM_BACKUP_DIR=
CRM_LOGS_DIR=
CRM_OUTPUT_DIR=
CRM_TMP_DIR=

# Set this whenever HOST is exposed to a LAN. Open the UI once with ?token=<value>.
CRM_ACCESS_TOKEN=
# Sales CRM 首次初始化管理员；初始化完成后请在系统内修改密码。
CRM_ADMIN_EMAIL=admin@crm.local
CRM_ADMIN_PASSWORD=ChangeMe123!
CRM_SEED_DEMO_DATA=false
CRM_ENABLE_LEGACY=false
# 合作客户保护写入默认关闭；只读身份预检不依赖此开关。
CRM_PROTECTED_CUSTOMERS_WRITES_ENABLED=false
# 客户计划按统一业务时区解析；新计划事件双写首次部署保持关闭。
CRM_BUSINESS_TIMEZONE=Asia/Shanghai
CRM_DEFERRED_PLAN_WRITES_ENABLED=false
# 活动归属更正首次部署保持关闭；完成权限与回滚验证后再单独启用。
CRM_ACTIVITY_CORRECTIONS_ENABLED=false
CRM_TEAM_STATUS_WRITES_ENABLED=false
# AI Station 在 production 未配置时默认关闭；开发验收需显式设为 true。
CRM_AI_STATIONS_ENABLED=false
# 独立 AI Station Worker。全局和 Router 引擎槽位由数据库跨进程协调。
CRM_AI_WORKER_ID=
CRM_AI_JOB_LEASE_MS=60000
CRM_AI_WORKER_IDLE_MS=1000
CRM_AI_WORKER_LIMIT=
CRM_AI_EXECUTION_TIMEOUT_MS=75000
# 未配置时使用 global=10、qwen=4、deepseek=4、web=4、kimi-cli=1、hermes=1，rateLimit=0 表示不启用速率上限。
# 示例：{"global":{"maxConcurrency":8,"rateLimit":60,"rateWindowMs":60000},"qwen":{"maxConcurrency":4,"rateLimit":30,"rateWindowMs":60000},"deepseek":{"maxConcurrency":4,"rateLimit":30,"rateWindowMs":60000},"kimi-cli":{"maxConcurrency":1,"rateLimit":0,"rateWindowMs":60000},"hermes":{"maxConcurrency":1,"rateLimit":0,"rateWindowMs":60000}}
CRM_AI_EXECUTION_RESOURCES_JSON=
# 可选：把工作站任务映射到额外的任务级资源；实际 Router 引擎仍在调用时单独占用对应槽位。
# 示例：{"customer_fit":"model"}
CRM_AI_STATION_RESOURCES_JSON=
# AI 成本以 USD 为单位、持久台账以微美元存储。未配置价格时使用保守的 control-plane-default-v1。
CRM_AI_COMPANY_ID=default
# 示例：{"version":"internal-pricing-v1","default":{"defaultAttemptCost":0.05,"inputPerMillion":1,"outputPerMillion":4,"reserveInputTokens":3000,"reserveOutputTokens":1500},"engines":{"deepseek":{"inputPerMillion":1,"outputPerMillion":4}},"models":{}}
CRM_AI_PRICING_JSON=
# 0 表示该周期不设上限；scopeType 支持 company/team/user/station。达到 80% 告警，达到 100% 阻断新的非必要模型调用。
# 示例：[{"scopeType":"company","scopeId":"default","dailyLimit":20,"monthlyLimit":400,"perTaskLimit":0.5,"warningRatio":0.8}]
CRM_AI_BUDGET_POLICIES_JSON=
CRM_AI_QUEUE_BACKLOG_WARNING=100
CRM_AI_QUEUE_WAIT_WARNING_MS=300000
# A1-09 客户富化默认关闭。仅在隔离开发环境显式开启这两个开关。
CRM_AI_CUSTOMER_ENRICHMENT_ENABLED=false
CRM_AI_CUSTOMER_ENRICHMENT_AUTO_TRIGGER_ENABLED=false
# A1-09 真实模型 smoke：必须使用独立开发数据库与开发账号，不得填写生产凭据。
CRM_AI_ENRICHMENT_SMOKE_DB_PATH=
CRM_AI_ENRICHMENT_SMOKE_BASE_URL=http://127.0.0.1:3100
CRM_AI_ENRICHMENT_SMOKE_EMAIL=
CRM_AI_ENRICHMENT_SMOKE_PASSWORD=
CRM_AI_ENRICHMENT_SMOKE_OWNER_ID=
CRM_AI_ENRICHMENT_SMOKE_COMPANY_NAME=TradePulse A1-09 Smoke
CRM_AI_ENRICHMENT_SMOKE_WEBSITE=
CRM_AI_ENRICHMENT_SMOKE_COUNTRY=
# 企业微信机器人 Webhook；不配置时通知仍保留在系统内。
WECOM_WEBHOOK_URL=
# 公网部署域名，例如 crm.example.com
CRM_DOMAIN=
RECON_WORKER_TOKEN=
RECON_WEBAPP_URL=http://127.0.0.1:3000/api/recon
RECON_OUTPUT_DIR=recon-runs
RECON_POLL_SECONDS=10
RECON_AGENT_TIMEOUT=1200
RECON_WORKER_ID=
CONTACT_RECON_URL=http://127.0.0.1:3000/api/contact-recon
CONTACT_RECON_OUTPUT_DIR=contact-recon-runs
CONTACT_RECON_REPORT_DIR=contact-recon-reports
CONTACT_RECON_TIMEOUT=1800
CONTACT_RECON_POLL_SECONDS=15
REPORT_SHARE_TOKEN=
PUBLIC_REPORT_BASE_URL=
CONTACT_RECON_WORKER_ID=
CONTACT_RECON_HERMES_SKILL=russia-contact-recon

BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
OPENSANCTIONS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# 在线 Qwen 路由硬门禁；关闭后 auto 恢复 Kimi → Hermes → DeepSeek 旧路由。
CRM_AI_QWEN_ONLINE_ENABLED=false
# 夜间 Batch 硬门禁；数据库运行时开关默认关闭，需管理员再次开启。
CRM_AI_QWEN_BATCH_ENABLED=false
# AI 工作助理使用自动路由；也可固定为 qwen、kimi-cli、hermes 或 deepseek。
ASSISTANT_ENGINE=auto
# 健康监测与自动回退预算。失败引擎在重试窗口内断路，自动模式最多尝试两个引擎。
ASSISTANT_HEALTH_RETRY_MS=300000
ASSISTANT_HEALTH_INTERVAL_MS=300000
ASSISTANT_HEALTH_PROBE_TIMEOUT_MS=12000
ASSISTANT_ROUTER_TIMEOUT_MS=75000
ASSISTANT_ROUTER_MAX_ATTEMPTS=2
ASSISTANT_AUTO_ATTEMPT_TIMEOUT_MS=30000
ASSISTANT_KIMI_BIN=/Users/ylf/.kimi-code/bin/kimi
ASSISTANT_KIMI_HOME=/Users/ylf/.kimi-code-crm
ASSISTANT_KIMI_MODEL=k3
ASSISTANT_KIMI_EFFORT=low
ASSISTANT_KIMI_TIMEOUT_MS=45000
ASSISTANT_KIMI_MAX_CONCURRENT=1
ASSISTANT_KIMI_MAX_OUTPUT=18000
ASSISTANT_KIMI_MAX_COMPLETION_TOKENS=1200
ASSISTANT_KIMI_MAX_CONTEXT=1048576
ASSISTANT_KIMI_SKILLS_DIR=
ASSISTANT_KIMI_CREDENTIALS_FILE=
# Hermes 主对话引擎。
ASSISTANT_HERMES_BIN=/Users/ylf/.hermes/hermes-agent/venv/bin/hermes
ASSISTANT_HERMES_HOME=/Users/ylf/.hermes-crm
ASSISTANT_HERMES_PROVIDER=opencode-go
ASSISTANT_HERMES_MODEL=deepseek-v4-flash
ASSISTANT_HERMES_TIMEOUT_MS=60000
ASSISTANT_HERMES_MAX_TURNS=2
ASSISTANT_HERMES_MAX_CONCURRENT=1
ASSISTANT_HERMES_MAX_OUTPUT=18000
ASSISTANT_HERMES_MAX_PROMPT=50000
# Hermes 失败时是否回退到 DeepSeek（需要 DEEPSEEK_API_KEY 有可用余额）。
ASSISTANT_HERMES_FALLBACK=false
DASHSCOPE_API_KEY=
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.7-plus
QWEN_FLASH_MODEL=qwen3.7-flash
QWEN_PLUS_MODEL=qwen3.7-plus
QWEN_TIMEOUT_MS=30000
QWEN_MAX_TOKENS=3000
QWEN_TEMPERATURE=0.2
QWEN_TOP_P=0.8
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
CRM_AI_STATION_MODEL_MAP_JSON=
CRM_AI_QWEN_BATCH_SCHEDULE=02:00
CRM_AI_QWEN_BATCH_TIMEZONE=Asia/Shanghai
CRM_AI_QWEN_BATCH_MAX_ITEMS=100
CRM_AI_QWEN_BATCH_STALE_REQUEUE_LIMIT=2
CRM_AI_QWEN_BATCH_WORKER_ID=
CRM_AI_BATCH_JOB_LEASE_MS=3600000
QWEN_BATCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BATCH_TIMEOUT_MS=30000
QWEN_BATCH_COMPLETION_WINDOW=24h
# 价格必须包含 version/model/executionType=batch/currency/生效时间；促销价必须提供 promotionEndsAt。
CRM_AI_QWEN_PRICING_CATALOG_JSON=
# CNY→USD 汇率必须包含 version/rate/effectiveFrom/source。
CRM_AI_CNY_USD_FX_JSON=
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
