[Unit]
Description=TradePulse unified CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradepulse
Group=tradepulse
WorkingDirectory=/opt/tradepulse
EnvironmentFile=/opt/tradepulse/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/tradepulse/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradepulse/data /opt/tradepulse/logs /opt/tradepulse/reports /opt/tradepulse/recon-runs /opt/tradepulse/contact-recon-reports

[Install]
WantedBy=multi-user.target
