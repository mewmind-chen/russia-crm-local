{
  "name": "russia-crm-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "crm:setup": "node -e \"require('./lib/sales_crm').installSalesCrm(); console.log('Sales CRM ready')\"",
    "crm:intake:daily": "node scripts/import-daily-sales-crm.js",
    "crm:migrate:unified:dry": "node scripts/migrate-unified-crm.js",
    "crm:migrate:unified": "node scripts/migrate-unified-crm.js --apply",
    "crm:reset-to-leads": "node scripts/reset-crm-to-undeveloped-leads.js",
    "crm:notify": "node scripts/dispatch-crm-notifications.js",
    "migrate": "node scripts/migrate.js",
    "assistant:index": "node scripts/assistant_index.js",
    "daily:import": "node scripts/import-daily-normalized.js",
    "bot3:pipeline:import:dry": "node scripts/import-bot3-crm-pipeline.js",
    "bot3:pipeline:import": "node scripts/import-bot3-crm-pipeline.js --apply",
    "customer-ids:normalize": "node scripts/normalize-customer-ids.js --apply",
    "customer-ids:check": "node scripts/normalize-customer-ids.js",
    "grades:reset-unrecon": "node scripts/reset-unrecon-grades.js --apply",
    "grades:check-unrecon": "node scripts/reset-unrecon-grades.js",
    "bot3:blocklist:export": "node scripts/export-domain-blocklist.js",
    "taxonomy:normalize": "node scripts/normalize-taxonomy.js",
    "recon:backfill": "node scripts/backfill-recon-results.js",
    "recon:v2": "node scripts/regenerate-recon-v2-from-evidence.js",
    "recon:daily": "node scripts/recon-daily.js --limit 10 --enqueue-only --json-out tmp/codex-recon-today.json",
    "recon:enqueue-daily": "node scripts/recon-daily.js --limit 10 --enqueue-only --json-out tmp/codex-recon-today.json",
    "recon:hermes:daily": "node scripts/recon-daily.js --limit 10 --run-worker",
    "contact-recon:once": "python3 scripts/contact_recon_worker.py --once",
    "contact-recon:worker": "python3 scripts/contact_recon_worker.py",
    "recon:codex:submit": "node scripts/submit-codex-recon-result.js",
    "recon:regrade": "node scripts/regrade-recon-results.js",
    "recon:regrade:apply": "node scripts/regrade-recon-results.js --apply",
    "quality:audit": "node scripts/audit-data-quality.js",
    "quality:audit:strict": "node scripts/audit-data-quality.js --strict",
    "quality:normalize": "node scripts/normalize-data-quality.js",
    "quality:normalize:apply": "node scripts/normalize-data-quality.js --apply",
    "contact-quality:migrate": "node scripts/migrate-contact-quality.js",
    "contact-quality:migrate:apply": "node scripts/migrate-contact-quality.js --apply"
    ,"company-screening:preview": "node scripts/classify-company-pool.js"
    ,"company-screening:run": "node scripts/classify-company-pool.js --apply"
    ,"contact-recon:enqueue": "node scripts/enqueue-contact-recon.js"
    ,"contact-recon:enqueue:dry": "node scripts/enqueue-contact-recon.js --dry-run"
    ,"delivery:generate": "node scripts/generate-daily-delivery.js"
    ,"delivery:daily": "node scripts/daily-customer-delivery.js"
    ,"delivery:daily:enqueue": "node scripts/daily-customer-delivery.js --enqueue"
    ,"delivery:services:install": "node scripts/install-daily-services.js"
    ,"contact-recon:replay": "python3 scripts/replay_contact_recon_failures.py"
    ,"contact-recon:replay:apply": "python3 scripts/replay_contact_recon_failures.py --apply"
    ,"contact-recon:notify:dry": "node scripts/notify-contact-recon-complete.js --dry-run"
    ,"contact-recon:notify:force": "node scripts/notify-contact-recon-complete.js --force"
    ,"contact-delivery:regrade": "node scripts/regrade-contact-delivery.js"
    ,"reports:share:setup": "node scripts/setup-report-sharing.js"
    ,"contact-reports:generate": "node scripts/generate-contact-recon-reports.js"
    ,"deploy:mac:once": "zsh scripts/deploy-from-github.sh"
    ,"deploy:mac:retry": "zsh scripts/deploy-from-github.sh --force"
    ,"deploy:mac:install": "node scripts/install-auto-deploy.js"
    ,"deploy:mac:status": "node scripts/deploy-state.js status"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "engines": {
    "node": ">=18"
  }
}
