{
  "$id": "tradepulse://ai/distribution_priority/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "confidence", "evidenceIds", "reasonCodes", "priority", "urgency", "blockingReasons"],
  "properties": {
    "version": { "const": "v1" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
    },
    "priority": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "urgency": { "type": "integer", "minimum": 0, "maximum": 100 },
    "blockingReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
