{
  "$id": "tradepulse://ai/manager_anomaly/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "anomalyId",
    "anomalyCode",
    "customerId",
    "severity",
    "priorityScore",
    "explanation",
    "interventionSuggestion",
    "evidenceIds",
    "confidence",
    "reviewRequired"
  ],
  "properties": {
    "version": { "const": "v1" },
    "anomalyId": { "type": "string", "minLength": 1, "maxLength": 220 },
    "anomalyCode": {
      "type": "string",
      "enum": [
        "MEETING_NO_RFQ",
        "RFQ_UNQUOTED",
        "QUOTE_IDLE",
        "HIGH_VALUE_STALE",
        "WORKLOAD_IMBALANCE"
      ]
    },
    "customerId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "severity": { "type": "string", "enum": ["critical", "warning"] },
    "priorityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "interventionSuggestion": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewRequired": { "const": true }
  }
}
