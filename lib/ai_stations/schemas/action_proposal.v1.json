{
  "$id": "tradepulse://ai/action_proposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "activityType",
    "channel",
    "outcome",
    "summary",
    "nextAction",
    "nextActionAt",
    "missingFields",
    "evidenceIds",
    "confidence",
    "reviewRequired"
  ],
  "properties": {
    "version": { "const": "v1" },
    "activityType": {
      "type": "string",
      "enum": ["", "email", "call", "social", "reply", "meeting", "manager_join", "rfq", "negotiation", "lost"]
    },
    "channel": {
      "type": "string",
      "enum": ["", "email", "call", "WhatsApp", "Telegram", "LinkedIn", "video", "展会", "business", "other"]
    },
    "outcome": {
      "type": "string",
      "enum": ["", "已完成", "有兴趣", "需要跟进", "未接通", "暂无回复", "明确拒绝"]
    },
    "summary": { "type": "string", "maxLength": 4000 },
    "nextAction": { "type": "string", "maxLength": 1000 },
    "nextActionAt": { "type": "string", "maxLength": 80 },
    "missingFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["activityType", "channel", "outcome", "summary", "nextAction", "nextActionAt"]
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewRequired": { "const": true }
  }
}
