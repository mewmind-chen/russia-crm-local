{
  "$id": "tradepulse://ai/contact_readiness/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "confidence", "evidenceIds", "reasonCodes", "readiness", "contactIds"],
  "properties": {
    "version": { "const": "v1" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
    },
    "readiness": { "type": "string", "enum": ["ready", "partial", "not_ready"] },
    "contactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
