{
  "$id": "tradepulse://ai/next_action/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nextAction",
    "nextActionAt",
    "managerRequired",
    "reason",
    "missingFields",
    "evidenceIds",
    "confidence",
    "reviewRequired"
  ],
  "properties": {
    "version": { "const": "v1" },
    "nextAction": { "type": "string", "maxLength": 1000 },
    "nextActionAt": { "type": "string", "maxLength": 80 },
    "managerRequired": { "type": "boolean" },
    "reason": { "type": "string", "maxLength": 2000 },
    "missingFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["nextAction", "nextActionAt"]
      }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewRequired": { "const": true }
  }
}
